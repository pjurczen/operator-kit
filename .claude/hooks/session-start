#!/usr/bin/env bash
# SessionStart hook for operator-kit.
# Injects the operator orientation + a live-state snapshot (date, monitor liveness,
# uncommitted drift) as additionalContext, so the session boots in operator mode and
# a dead-monitor state or dirty tree is visible at start — not discovered at first tick.
# Never blocks startup: every step degrades to a message and the hook exits 0.

set -uo pipefail

PROJECT_DIR="${CLAUDE_PROJECT_DIR:-$(cd "$(dirname "$0")/../.." && pwd)}"

orientation=$(cat "${PROJECT_DIR}/.claude/operator-orientation.md" 2>&1 \
  || echo "Error reading operator orientation")

monitors=$(bash "${PROJECT_DIR}/scripts/monitor-status.sh" 2>/dev/null | paste -sd' ' - || true)
[ -n "$monitors" ] || monitors='monitor-status unavailable'

uncommitted=$(cd "${PROJECT_DIR}" 2>/dev/null && git status --short 2>/dev/null | head -15 | paste -sd';' - || true)

live_state="## Live state at session start
- Date: $(date +%F 2>/dev/null || true)
- Monitors: ${monitors}
- Uncommitted: ${uncommitted}"

payload="${orientation}

${live_state}"

# Escape a string for safe embedding inside a JSON string literal.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

content_escaped=$(escape_for_json "$payload")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$content_escaped"

exit 0
