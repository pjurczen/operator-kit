{
  "permissions": {
    "allow": [
      "Bash(bash scripts/check.sh)",
      "Bash(bash scripts/monitor-status.sh)",
      "Bash(bash scripts/monitor-status.sh:*)",
      "Bash(bash scripts/bootstrap-labels.sh:*)",
      "Bash(bash scripts/gh-relabel.sh:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh search issues:*)",
      "Bash(gh api repos/*)",
      "Bash(gh label create:*)",
      "Bash(date:*)",
      "Bash(ls:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git rm:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./private/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start\"", "async": false }
        ]
      }
    ]
  }
}
